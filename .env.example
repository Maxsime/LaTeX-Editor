# Copy to .env and adjust, or run scripts/init-env.sh, which also generates every
# secret. Every variable is optional for a local instance: compose.yaml falls back
# to the defaults shown here. The API refuses to start with the development secrets
# below once GALLEY_HOST is anything but localhost.

# --- Public address -----------------------------------------------------------
# Host name served by Caddy. localhost uses Caddy's local certificate authority.
GALLEY_HOST=localhost
# "internal" for the local CA; an e-mail address enables Let's Encrypt (public hosts only).
GALLEY_TLS=internal
GALLEY_HTTP_PORT=80
GALLEY_HTTPS_PORT=443

# --- Logging ------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Accounts -------------------------------------------------------------------
# open: anyone may register | invite: an invitation link is required | closed: accounts
# are created by an administrator only (pnpm --filter @galley/api admin, see README).
REGISTRATION_MODE=invite
# Sessions expire after this many days without activity.
SESSION_TTL_DAYS=30

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=galley
POSTGRES_PASSWORD=galley-dev-password
POSTGRES_DB=galley

# --- Object storage (SeaweedFS, S3 API) ----------------------------------------
S3_ACCESS_KEY_ID=galley
# At least 8 characters.
S3_SECRET_ACCESS_KEY=galley-dev-secret
S3_BUCKET=galley

# --- Collaboration ----------------------------------------------------------------
# Shared secret between api and collab for internal calls (at least 32 characters).
COLLAB_INTERNAL_TOKEN=galley-dev-internal-token-change-me
# Text is written to PostgreSQL after this quiet period, and at least this often while typing.
COLLAB_PERSIST_DEBOUNCE_MS=2000
COLLAB_PERSIST_MAX_DEBOUNCE_MS=10000

# --- Git bridge -------------------------------------------------------------------
# Largest pack one `git push` may send (MiB); larger pushes are refused.
GIT_MAX_PUSH_MB=100
# Hosts a project may be synchronised with (pull and push on demand), comma-separated.
# Add your own GitLab, e.g. github.com,gitlab.com,gitlab.example.org
GIT_SYNC_HOSTS=github.com,gitlab.com
# Plain HTTP remotes; only for a mirror on a network you trust (and for tests).
GIT_SYNC_ALLOW_HTTP=false

# --- Compilation ------------------------------------------------------------------
# Compilations run at the same time by the worker.
COMPILER_CONCURRENCY=2
# Limits of one compilation: wall-clock seconds, address space per process (MiB),
# processes, size of the output folder (MiB).
COMPILER_TIMEOUT_S=180
COMPILER_MEMORY_MB=2048
COMPILER_MAX_PROCESSES=64
COMPILER_MAX_OUTPUT_MB=500
# Disk budget of the working folders kept between compilations (MiB); the least
# recently used projects are evicted beyond it.
COMPILER_WORK_QUOTA_MB=20480
# Lets projects choose unrestricted shell-escape (minted, gnuplot...). Commands still
# run inside the sandbox, without network. Projects asking for it otherwise compile
# with TeX Live's restricted list and get a warning.
COMPILER_ALLOW_FULL_SHELL_ESCAPE=false

# --- Secrets at rest ----------------------------------------------------------------
# Master key encrypting the users' Zotero and AI provider keys (AES-256-GCM): 32
# random bytes in base64, e.g. `openssl rand -base64 32`. The default below is public:
# the API warns at startup while it is in use. Changing it later makes stored keys
# unreadable (users enter them again).
GALLEY_MASTER_KEY=Z2FsbGV5LWRldi1tYXN0ZXIta2V5LWNoYW5nZS1tZSE=

# --- Writing tools ----------------------------------------------------------------
# Java heap of the LanguageTool server (spelling and grammar), e.g. 512m, 1g, 2g.
LANGUAGETOOL_MEMORY=1g
# Contact address sent to Crossref with DOI lookups, for its "polite" pool (optional).
CROSSREF_MAILTO=
# Bibliographic services called by the API; change only for a mirror.
# CROSSREF_URL=https://api.crossref.org
# ARXIV_URL=https://export.arxiv.org
# OPENLIBRARY_URL=https://openlibrary.org
# ZOTERO_URL=https://api.zotero.org

# Semantic Scholar is searched by the assistant only with a key (optional).
SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_URL=https://api.openalex.org
# SEMANTIC_SCHOLAR_URL=https://api.semanticscholar.org

# --- AI assistant ------------------------------------------------------------------
# Instance-wide switch; owners can also turn it off per project.
AI_ENABLED=true
# Model offered to every user without a configuration of their own (Mon compte).
# Provider: anthropic, openai, mistral or openai-compatible (Ollama, vLLM, LM Studio).
# Leave empty for none: each user then brings their own key.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
# Required for openai-compatible, e.g. http://host.docker.internal:11434/v1 for Ollama
# running on the Docker host. Empty for the official address of the other providers.
AI_DEFAULT_BASE_URL=
# Key of the default provider; never shown to users. Ollama needs none.
AI_DEFAULT_API_KEY=
# Capabilities of the default model when Galley does not know it (true/false, tokens).
AI_DEFAULT_VISION=
AI_DEFAULT_CONTEXT_TOKENS=
# Lets users point a provider at an address of their choice. The API then calls any
# address a user types, internal ones included: enable only among trusted users.
AI_ALLOW_USER_ENDPOINTS=false
# Assistant requests per user and per minute.
AI_RATE_LIMIT_PER_MINUTE=20
# Tokens (input and output) one request of the agent mode may use, every step
# included; the agent stops after the step that reaches it. Also set in the console.
AI_AGENT_TOKEN_BUDGET=200000

# --- Quotas ---------------------------------------------------------------------
# Defaults for every account; empty means unlimited. The administration console
# (/admin) overrides them, for the instance or for one person.
# Megabytes of project files a person may own (trash included until purged).
QUOTA_STORAGE_MB=
# Minutes of compilation a person may start per calendar month.
QUOTA_COMPILE_MINUTES=

# --- Single sign-on (OpenID Connect) ---------------------------------------------
# One provider: Keycloak, Authentik, Google... (GitHub through Keycloak or Authentik).
# Register the redirect URI https://<GALLEY_HOST>/api/auth/oidc/callback there.
# Sign-in through it is off while OIDC_ISSUER is empty.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label of the button on the sign-in page.
OIDC_DISPLAY_NAME=SSO
OIDC_SCOPES=openid email profile
# Creates an account on first sign-in even when REGISTRATION_MODE is not open.
OIDC_ALLOW_SIGNUP=false

# --- Linked files ----------------------------------------------------------------
# Files may be linked to a public web address and refreshed on request. Only
# public addresses are fetched (never the instance's own network).
LINKED_URLS_ENABLED=true

# --- E-mail ----------------------------------------------------------------------
# Outgoing mail server. While SMTP_URL is empty, nothing is sent: passwords are
# reset by an administrator, and invitations and mentions show only in the app.
# smtp://host:587 upgrades with STARTTLS when the server offers it; smtps://host:465
# is TLS from the start. Credentials go in the URL, percent-encoded:
# SMTP_URL=smtps://galley%40example.org:app-password@mail.example.org:465
SMTP_URL=
# Sender of every message; required when SMTP_URL is set.
SMTP_FROM=Galley <galley@example.org>

# --- Backups (scripts/backup.sh) -------------------------------------------------
# Backups older than this many days are deleted after each new one.
BACKUP_KEEP_DAYS=14

# --- Host development (pnpm dev, with compose.dev.yml) ------------------------
# Used only when services run on the host rather than in containers.
DATABASE_URL=postgres://galley:galley-dev-password@localhost:5432/galley
VALKEY_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
COLLAB_INTERNAL_URL=http://localhost:3001
GIT_DATA_DIR=/tmp/galley-git
# LanguageTool of compose.dev.yml; spell checking is off when unset.
LANGUAGETOOL_URL=http://localhost:8010
