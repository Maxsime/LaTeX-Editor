#!/bin/sh
# Scans the staged changes for secrets before each commit (docs/security.md).
# Enabled by "pnpm install", which points core.hooksPath at this folder.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, staged changes not scanned for secrets." >&2
  echo "pre-commit: install it (Windows: winget install gitleaks, macOS: brew install gitleaks)." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
