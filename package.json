{
  "name": "galley",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted collaborative LaTeX editor with an integrated AI assistant",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @galley/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
