{
  "name": "@galley/compiler",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:corpus": "node scripts/corpus.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@galley/latex-log": "workspace:*",
    "@galley/shared": "workspace:*",
    "bullmq": "6.4.2",
    "ioredis": "5.11.1",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
