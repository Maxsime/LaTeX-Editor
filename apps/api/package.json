{
  "name": "@galley/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "admin": "tsx --env-file-if-exists=../../.env src/cli/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@galley/ai": "workspace:*",
    "@galley/db": "workspace:*",
    "@galley/latex-index": "workspace:*",
    "@galley/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@retorquere/bibtex-parser": "12.1.3",
    "bullmq": "6.4.2",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "mime": "4.1.1",
    "openid-client": "6.8.8",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "re2js": "2.8.6",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "0.31.11",
    "oauth2-mock-server": "9.2.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
