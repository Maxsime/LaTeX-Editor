{
	# The admin API is not needed at runtime and would be one more open port.
	admin off
	servers {
		# Caddy sets no timeout by default: a client trickling its headers, or
		# leaving idle keep-alive connections open, would hold sockets forever.
		# Bodies and responses stay unbounded for uploads, PDFs and AI streams;
		# upgraded WebSocket connections are not subject to these.
		timeouts {
			read_header 15s
			idle 5m
		}
	}
}

# Internal health endpoint for the container health check, never published.
http://:2019 {
	respond /healthz "ok" 200
}

{$GALLEY_HOST:localhost} {
	# Local CA; set GALLEY_TLS to an e-mail address to use ACME on a public host (J10).
	tls {$GALLEY_TLS:internal}
	encode zstd gzip

	header {
		# "?" keeps a stricter policy set by the API, e.g. on user file downloads.
		# The style nonce, new on every response, lets CodeMirror insert its style sheet;
		# index.html hands it to the client (see the templates directive below).
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-{http.request.uuid}'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Another site may not embed our responses (user files, PDFs) as images or scripts.
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Git smart HTTP; the API authenticates with personal access tokens.
	handle /git/* {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Only WebSocket upgrades reach collab; its probes and metrics stay internal.
	@collab {
		path /collab /collab/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @collab {
		uri strip_prefix /collab
		reverse_proxy collab:3001
	}

	# Hashed assets never change: cached for a year, served from the .br, .zst and .gz
	# files written at build time (apps/web/scripts/precompress.mjs), so the strongest
	# compression costs nothing per request. A missing asset is a 404, not the page.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br zstd gzip
		}
	}

	handle {
		root * /srv
		# The page carries a new nonce on every load, so it is never cached, and it goes
		# through templates, which must see it uncompressed: encode compresses it after.
		header Cache-Control "no-store"
		try_files {path} /index.html
		@index path /index.html
		templates @index
		file_server
	}
}
